[Unit]
Description=RelayDock Mihomo WireGuard relay input allowance
After=network-online.target
Wants=network-online.target
Before=arcway.service

[Service]
Type=oneshot
RemainAfterExit=yes
RuntimeDirectory=arcway-wireguard-probe-egress
RuntimeDirectoryMode=0700
ExecStart=/opt/arcway/bin/arcway-wireguard-probe-egress apply
ExecStartPost=/opt/arcway/bin/arcway-wireguard-probe-egress status
ExecStop=/opt/arcway/bin/arcway-wireguard-probe-egress remove
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
