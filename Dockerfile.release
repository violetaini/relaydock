# syntax=docker/dockerfile:1.7

# Release images are assembled exclusively from the verified bundle produced by
# this workflow run. This native stage validates the shared checksum manifest
# before any target-platform image is created.
FROM --platform=$BUILDPLATFORM alpine:3.22 AS release-assets

ARG TARGETARCH

WORKDIR /release
COPY docker-release/ ./

RUN set -eux; \
    case "$TARGETARCH" in amd64|arm64) ;; *) echo "unsupported architecture: $TARGETARCH" >&2; exit 1 ;; esac; \
    sha256sum -c checksums.txt; \
    test -s "arcway-linux-$TARGETARCH"; \
    mkdir -p /image/guard-assets /image/agent-assets /image/speedtester-assets; \
    install -m 0755 "arcway-linux-$TARGETARCH" /image/server; \
    install -m 0755 arcway-expiry-guard-linux-* /image/guard-assets/; \
    install -m 0755 relaydock-agent-linux-* /image/agent-assets/; \
    install -m 0755 relaydock-speedtester-linux-* relaydock-speedtester-windows-* /image/speedtester-assets/; \
    install -m 0644 checksums.txt /image/release-checksums.txt

# Keep the runtime identical to the source-built image. Only the compilation
# stage is replaced by the checked same-run release artifacts above.
FROM nginx:mainline-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    tzdata \
    gosu \
    wget \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /usr/local/nginx/sbin /etc/nginx/cert /etc/nginx/servers /etc/nginx/stream_servers /etc/nginx/html \
    && ln -sfn /usr/sbin/nginx           /usr/local/nginx/sbin/nginx \
    && ln -sfn /etc/nginx/nginx.conf     /usr/local/nginx/nginx.conf \
    && ln -sfn /etc/nginx/cert           /usr/local/nginx/cert \
    && ln -sfn /etc/nginx/servers        /usr/local/nginx/servers \
    && ln -sfn /etc/nginx/stream_servers /usr/local/nginx/stream_servers \
    && ln -sfn /etc/nginx/html           /usr/local/nginx/html \
    && groupadd -g 1000 appuser \
    && useradd -u 1000 -g appuser -m appuser

COPY --from=release-assets --chown=1000:1000 /image/server /app/server
COPY --from=release-assets --chown=1000:1000 /image/guard-assets /app/guard-assets
COPY --from=release-assets --chown=1000:1000 /image/agent-assets /app/agent-assets
COPY --from=release-assets --chown=1000:1000 /image/speedtester-assets /app/speedtester-assets
COPY --from=release-assets /image/release-checksums.txt /app/release-checksums.txt
COPY --chown=1000:1000 rule_templates /app/rule_templates
COPY docker-entrypoint.sh /entrypoint.sh
RUN chmod 0755 /entrypoint.sh

VOLUME ["/app/data", "/app/subscribes"]

ENV BIND_HOST=0.0.0.0
ENV ARCWAY_GUARD_ASSET_DIR=/app/guard-assets
ENV ARCWAY_AGENT_ASSET_DIR=/app/agent-assets
ENV ARCWAY_SPEEDTESTER_ASSET_DIR=/app/speedtester-assets

EXPOSE 12889

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:12889/ || exit 1

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/app/server"]
